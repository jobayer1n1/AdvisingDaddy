{
  "manifest_version": 3,
  "name": "AdvisingDaddy",
  "version": "1.0",
  "description": "Automated course selection and alerts based on priority.",
  "browser_specific_settings": {
    "gecko": {
      "id": "advisingdaddynsu@jobayer.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://rds3.northsouth.edu/*"
  ],
  "icons":{
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://rds3.northsouth.edu/students/advising*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
